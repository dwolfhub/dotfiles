{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "permission": {
        "edit": "ask",
        "write": "ask",
        "webfetch": "allow",
        "bash": {
            "*": "ask",
            "aws elbv2 describe-*": "allow",
            "aws ecs describe-*": "allow",
            "aws cloudformation describe-*": "allow",
            "aws cloudformation list-*": "allow",
            "aws lambda list-functions *": "allow",
            "aws route53 list-*": "allow",
            "cat *": "allow",
            "echo *": "allow",
            "find *": "allow",
            "git blame *": "allow",
            "git log *": "allow",
            "git diff *": "allow",
            "git push *": "deny",
            "git remote": "allow",
            "git remote -v": "allow",
            "git branch -v": "allow",
            "git show *": "allow",
            "git status *": "allow",
            "mkdir *": "allow",
            "npm run lint *": "allow",
            "npx eslint *": "allow",
            "npm run tsc-out": "allow",
            "npm run prettier *": "allow",
            "npm run prettier:fix *": "allow",
            "jq *": "allow",
            "grep *": "allow",
            "head *": "allow",
            "ls *": "allow",
            "rg *": "allow",
            "sort *": "allow",
            "tail *": "allow",
            "wc *": "allow",
            "xargs grep *": "allow",
            "sleep *": "allow"
        }
    },
    "mcp": {
        "context7": {
            "type": "local",
            "command": ["npx", "-y", "@upstash/context7-mcp"]
        },
        "clear-thought": {
            "type": "local",
            "command": ["npx", "-y", "@waldzellai/clear-thought"]
        },
        "stochastic-thinking": {
            "type": "local",
            "command": ["npx", "-y", "@waldzellai/stochasticthinking"]
        },
        "chrome-devtools": {
            "type": "local",
            "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
        }
    },
    "provider": {
        "claude-4-sonnet": {
            "npm": "@ai-sdk/anthropic",
            "name": "Iliad",
            "options": {
                "baseURL": "https://api-epic.ir-gateway.abbvienet.com/iliad/anthropic/v1",
                "apiKey": "{env:ILIAD_API_KEY}"
            },
            "models": {
                "claude-sonnet-4-20250514": {
                    "name": "Claude 4 Sonnet"
                },
                "claude-opus-4-20250514": {
                    "name": "Claude 4 Opus"
                },
                "claude-3-7-sonnet-20250219": {
                    "name": "Claude 3.7 Sonnet"
                },
                "claude-3-5-sonnet-20241022": {
                    "name": "Claude 3.5 Sonnet (v2)"
                },
                "claude-3-5-sonnet-20240620": {
                    "name": "Claude 3.5 Sonnet (v1)"
                },
                "claude-3-5-haiku-20241022": {
                    "name": "Claude 3.5 Haiku"
                },
                "claude-3-sonnet-20240229": {
                    "name": "Claude 3 Sonnet"
                },
                "claude-3-opus-20240229": {
                    "name": "Claude 3 Opus"
                },
                "claude-3-haiku-20240307": {
                    "name": "Claude 3 Haiku"
                },
                "claude-sonnet-4-5-20250929": {
                    "name": "Claude 4.5 Sonnet"
                }
            }
        },
        "gpt-4.1": {
            "npm": "@ai-sdk/azure",
            "name": "Iliad",
            "options": {
                "baseURL": "https://api-epic.ir-gateway.abbvienet.com/iliad/openai/deployments/gpt-4.1/chat/completions?api-version=2024-02-01",
                "apiKey": "{env:ILIAD_API_KEY}"
            },
            "models": {
                "gpt-4.1": {
                    "name": "GPT 4.1"
                }
            }
        },
        "gpt-4.1-mini": {
            "npm": "@ai-sdk/azure",
            "name": "Iliad",
            "options": {
                "baseURL": "https://api-epic.ir-gateway.abbvienet.com/iliad/openai/deployments/gpt-4.1-mini/chat/completions?api-version=2024-02-01",
                "apiKey": "{env:ILIAD_API_KEY}"
            },
            "models": {
                "gpt-4.1-mini": {
                    "name": "GPT 4.1 Mini"
                }
            }
        },
        "gpt-4.1-nano": {
            "npm": "@ai-sdk/azure",
            "name": "Iliad",
            "options": {
                "baseURL": "https://api-epic.ir-gateway.abbvienet.com/iliad/openai/deployments/gpt-4.1-nano/chat/completions?api-version=2024-02-01",
                "apiKey": "{env:ILIAD_API_KEY}"
            },
            "models": {
                "gpt-4.1-nano": {
                    "name": "GPT 4.1 Nano"
                }
            }
        },
        "o3-global": {
            "npm": "@ai-sdk/azure",
            "name": "Iliad",
            "options": {
                "baseURL": "https://api-epic.ir-gateway.abbvienet.com/iliad/openai/deployments/o3-global/chat/completions?api-version=2024-02-01",
                "apiKey": "{env:ILIAD_API_KEY}"
            },
            "models": {
                "o3-global": {
                    "name": "O3"
                }
            }
        },
        "gpt-5-global": {
            "npm": "@ai-sdk/azure",
            "name": "Iliad",
            "options": {
                "baseURL": "https://api-epic.ir-gateway.abbvienet.com/iliad/openai/deployments/gpt-5-global/chat/completions?api-version=2024-02-01",
                "apiKey": "{env:ILIAD_API_KEY}"
            },
            "models": {
                "gpt-5-global": {
                    "name": "GPT 5"
                }
            }
        },
        "o4-mini-global": {
            "npm": "@ai-sdk/azure",
            "name": "Iliad",
            "options": {
                "baseURL": "https://api-epic.ir-gateway.abbvienet.com/iliad/openai/deployments/o4-mini-global/chat/completions?api-version=2024-02-01",
                "apiKey": "{env:ILIAD_API_KEY}"
            },
            "models": {
                "o4-mini-global": {
                    "name": "O4 Mini"
                }
            }
        }
    }
}
